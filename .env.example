# Required
OPENROUTER_API_KEY=

# PostgreSQL with the pgvector extension
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=life_knowledge_os

# Owner login for the protected /documents endpoints (see README → Authentication).
# Until all three are set, every login is rejected and /documents stays locked.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=''
JWT_SECRET_KEY=

# Optional — defaults shown
# CHAT_MODEL=~openai/gpt-sol-latest
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# CHAT_MAX_TOKENS=1500
# EMBEDDING_BATCH_SIZE=100
# AI_REQUEST_TIMEOUT_SECONDS=60
# TOP_K=5
# MIN_SIMILARITY=0.15
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# OWNER_NAME=Salman
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# UPLOAD_MAX_BYTES=1048576
